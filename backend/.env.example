# Copy to backend/.env and edit. Every value has a sensible default.

# ---- Camera ----
# Cameras are added and edited in the dashboard (+ Add camera).
# CAMERA_SOURCE is only used to create "Camera 1" on the very first run.
# 0 = first USB webcam, 1 = second, ...
CAMERA_SOURCE=0
# IP camera example (most use TCP 554; path depends on the brand):
# CAMERA_SOURCE=rtsp://admin:password@192.168.1.64:554/Streaming/Channels/102
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720

# ---- Performance ----
PROCESS_FPS=3            # face recognition passes per second, per camera
STREAM_FPS=12            # browser video frame rate
TRACK_FPS=8              # box position updates/sec between recognitions (0 = off)
MOTION_ENABLED=true      # only run recognition while something moves
MOTION_THRESHOLD=0.004   # fraction of pixels that must change
MODEL_NAME=buffalo_l     # buffalo_l = accurate, buffalo_s = faster on weak CPUs
DET_SIZE=640             # lower (e.g. 480) = faster, misses small/distant faces

# ---- Recognition ----
MATCH_THRESHOLD=0.45     # cosine similarity; raise to reduce false matches
MIN_FACE_SIZE=40
EVENT_COOLDOWN_SECONDS=30
LOG_UNKNOWN=false

# ---- Website sync (optional) ----
# Put the Firebase service-account key at backend/firebase-key.json (or set a path here)
# to send detections and camera status to https://safeface-3bc6e.web.app
# FIREBASE_CREDENTIALS=C:\SafeFace\backend\firebase-key.json

# ---- Security / web ----
# Required if the backend is reachable from the internet:
API_KEY=
# Comma-separated; put your Firebase domains here in production:
# CORS_ORIGINS=https://your-project.web.app,https://your-project.firebaseapp.com
CORS_ORIGINS=*
